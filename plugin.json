{
  "id": "nodebb-plugin-google-chat-integration",
  "name": "Google Chat Integration",
  "description": "NodeBB plugin that posts new and deleted topic/post notifications to Google Chat via incoming webhooks, with per-topic webhook selection.",
  "hooks": [
    {
      "hook": "static:app.load",
      "method": "init"
    },
    {
      "hook": "filter:admin.header.build",
      "method": "addAdminNavigation"
    },
    {
      "hook": "action:post.save",
      "method": "onPostSave"
    },
    {
      "hook": "filter:topic.create",
      "method": "onTopicCreate"
    },
    {
      "hook": "action:post.delete",
      "method": "onPostDelete"
    }
  ],
  "scripts": [
    "static/client.js"
  ],
  "staticDirs": {
    "static": "./static"
  },
  "templates": "templates",
  "version": "1.0.2",
  "author": "davids251",
  "library": "./library.js"
}
